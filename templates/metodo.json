    { "id": "corrections", "name": "Corrections", "branches": ["correction/"] }
  ],
  "bench": "~/.cache/myapp-review",
  "copyMarker": "CLAUDE.md",
  "lock": "~/.cache/myapp-e2e.lock",
  "protected": { "volumes": [], "stacks": [], "folders": [] },
  "release": [],
  "jobs": {},
  "deliveryChecks": [],
  "docs": { "blocks": "docs/blocks", "corrections": "docs/corrections.md" }
}
